{
  "name": "url-crawler",
  "version": "1.0.0",
  "description": "A TypeScript library to crawl and extract cleaned HTML content from URLs.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crawler": {
      "types": "./dist/entries/crawler.d.ts",
      "default": "./dist/entries/crawler.js"
    },
    "./types": {
      "types": "./dist/entries/types.d.ts",
      "default": "./dist/entries/types.js"
    },
    "./config": {
      "types": "./dist/entries/config.d.ts",
      "default": "./dist/entries/config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "cheerio": "^1.1.2",
    "sanitize-html": "^1.27.0"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.31",
    "@types/node": "^20.0.0",
    "@types/sanitize-html": "^2.16.0",
    "typescript": "^4.1.2"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
