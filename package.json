{
  "name": "url-crawler",
  "version": "1.0.0",
  "description": "A library to crawl and extract cleaned HTML content from URLs.",
  "keywords": ["crawler", "web-crawler", "html", "scraping", "typescript"],
  "author": "Romit Sanyal <sanyalromit1990@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romits1990/url-crawler.git"
  },
  "bugs": {
    "url": "https://github.com/romits1990/url-crawler/issues"
  },
  "homepage": "https://github.com/romits1990/url-crawler#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crawler": {
      "types": "./dist/entries/crawler.d.ts",
      "default": "./dist/entries/crawler.js"
    },
    "./types": {
      "types": "./dist/entries/types.d.ts",
      "default": "./dist/entries/types.js"
    },
    "./config": {
      "types": "./dist/entries/config.d.ts",
      "default": "./dist/entries/config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cheerio": "^1.0.0",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^2.11.0",
    "bottleneck": "^2.19.5"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/sanitize-html": "^2.9.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
