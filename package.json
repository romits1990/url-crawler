{
  "name": "url-crawler",
  "version": "1.0.0",
  "description": "A library to crawl and extract cleaned HTML content from URLs.",
  "author": "Romit Sanyal <sanyalromit1990@gmail.com>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romits1990/url-crawler.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./crawler": {
      "types": "./dist/entries/crawler.d.ts",
      "default": "./dist/entries/crawler.js"
    },
    "./types": {
      "types": "./dist/entries/types.d.ts",
      "default": "./dist/entries/types.js"
    },
    "./config": {
      "types": "./dist/entries/config.d.ts",
      "default": "./dist/entries/config.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^0.21.1",
    "cheerio": "^1.1.2",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^1.27.0",
    "bottleneck": "^2.19.5"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.31",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/sanitize-html": "^2.16.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^4.1.2"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
